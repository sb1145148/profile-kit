# ============================================================
#  Cloudflare Pages 自定义响应头
#  文件位置：frontend/_headers
#
#  格式：一个路径模式 + 若干缩进的头，空行分隔多组。
#
#  ------------------------------------------------------------
#  ⚠️ 这里只放「安全头」。缓存相关的头故意不动：
#     Pages 的默认是 HTML max-age=0、JS/CSS max-age=14400，
#     配合我们自己的 ?v=<内容哈希> 已经够用。
#     改成 immutable + 一年确实更省流量，但有个真实风险：
#     万一在部署还没传播完就去请求新的 ?v= 地址，边缘会把旧内容
#     缓存到新 URL 上——上次我就这么干过，靠换版本号才救回来。
#     配上 immutable 的话，那个错误的缓存会留一整年。
#     所以宁可保守。
# ============================================================


# ---------- 全站 ----------
/*
  # 禁止浏览器「猜」内容类型。
  # 没有这个头时，某些浏览器会把声明为 text/plain 的文件当 HTML 执行——
  # /api/media/ 返回的是图片，但万一哪天有接口返回用户可控的内容，
  # 这一行能挡住 MIME 嗅探型 XSS。
  X-Content-Type-Options: nosniff

  # 跨站跳转时只带来源域名，不带完整路径。
  # 你的文章地址是 /a/<slug>，带上完整 URL 等于把用户在看哪篇
  # 泄露给外链站点（比如分享到微博后，微博能收到你从哪篇文章点过去的）。
  Referrer-Policy: strict-origin-when-cross-origin

  # 不允许别人用 iframe 套你的站。
  # 防的是「点击劫持」——把真站点透明叠在假页面上骗点击。
  # 你的站没有需要被嵌入的场景，所以 SAMEORIGIN 不会误伤。
  X-Frame-Options: SAMEORIGIN

  # 关掉一堆用不到的浏览器能力。
  # 关了之后，即使有脚本被注入也拿不到定位、麦克风、支付接口。
  # 注意：不包含 camera —— <input type="file" accept="image/*">
  # 在手机上会调起相机，那是系统 intent，不受这里影响，
  # 但写上 camera=() 容易让人误解，索性不写。
  Permissions-Policy: geolocation=(), microphone=(), payment=(), usb=()


# ------------------------------------------------------------
# 这里**故意没有** Strict-Transport-Security（HSTS）
#
# 原因：Pages 的 _headers 只作用于静态资源，覆盖不到 Worker 的 API 响应。
#       而 HSTS 是「按域名」生效的——只要有一个响应不带它，浏览器就学到
#       一次「这个域名没开 HSTS」，等于白配。
#
#       所以 HSTS 请在 Cloudflare 控制台开，对全部响应生效：
#         SSL/TLS → Edge Certificates → HTTP Strict Transport Security (HSTS)
#
#       建议值：max-age=31536000; includeSubDomains
#       ⚠️ 先不要勾 preload —— 提交进浏览器内置列表容易，撤出来要好几个月
# ------------------------------------------------------------
